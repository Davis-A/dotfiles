{{- $tags := dig .chezmoi.hostname "tags" (list) .hosts -}}
set -g default-terminal "tmux-256color"

set -g history-limit 200000

{{- if eq .chezmoi.hostname "neon" }}
set -g status-bg "#ff5f5f"
{{- else if has "workstation" $tags }}
set -g status-bg magenta
{{- end }}
{{- if stat "/etc/inaboxinfo/" }}
{{- else }}
{{- /* Can't assume /usr/bin/fish because FreeBSD has it in /usr/local/bin/fish */}}
set-option -g default-shell {{ lookPath "fish" }}
{{ end }}

# stop weird characters on attach
# https://www.reddit.com/r/tmux/comments/1l7n9k9/what_are_these_strange_characters/
set -g escape-time 500

# Always use the stable agent-socket symlink (maintained by the shell rc
# on login) instead of the per-connection /tmp/ssh-*/agent.* path, so new
# panes work after detach/reattach. Drop SSH_AUTH_SOCK from
# update-environment so attaching clients don't overwrite it.
set -g update-environment "DISPLAY KRB5CCNAME SSH_ASKPASS SSH_AGENT_PID SSH_CONNECTION WINDOWID XAUTHORITY"
setenv -g SSH_AUTH_SOCK "{{ .chezmoi.homeDir }}/.ssh/agent.socket"


