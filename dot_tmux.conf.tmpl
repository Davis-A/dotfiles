{{- $tags := dig .chezmoi.hostname "tags" (list) .hosts -}}
set -g default-terminal "tmux-256color"

set -g history-limit 200000

{{- if eq .chezmoi.hostname "neon" }}
set -g status-bg "#ff5f5f"
{{- else if has "workstation" $tags }}
set -g status-bg magenta
{{- end }}
{{- if stat "/etc/inaboxinfo/" }}
{{- else }}
{{- /* Can't assume /usr/bin/fish because FreeBSD has it in /usr/local/bin/fish */}}
set-option -g default-shell {{ lookPath "fish" }}
{{ end }}

# stop weird characters on attach
# https://www.reddit.com/r/tmux/comments/1l7n9k9/what_are_these_strange_characters/
set -g escape-time 500


