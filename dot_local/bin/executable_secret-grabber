#!/usr/bin/env perl

# secret-grabber
# Grabs a secret from my secrets file and prints to stdout
# Can be used with (bash) export toke $(secret-grabber secrets.foo.bar)
# Then i can use curl one lingers using $token

# requires >= perl 5.36.0 and TOML module

use v5.36.0;
use TOML qw(from_toml);

my $path = shift @ARGV;
my $file = "$ENV{HOME}/.secrets/chezmoi-secrets.toml";

die "usage: secret-grabber <dotted.path.to.key>" unless (defined $path && !@ARGV);

open my $fh, '<', $file or do {
  die "cannot open $file: $!";
};

my $toml = do { local $/; <$fh> };
close $fh;

my ($data, $err) = from_toml($toml);
die "TOML parse error in $file: $err" unless $data;

(my $lookup = $path) =~ s/^secrets\.//;

my $node = $data->{secrets};
for my $part (split /\./, $lookup) {
  die "secret-grabber: no such secret: $path" unless (ref $node eq 'HASH' && exists $node->{$part});
  $node = $node->{$part};
}

die "'$path' is a table, not a value" if (ref $node);

say "$node";

