# Config for perl Data::Printer module
# This is a trimmed down one of Rik's @ github.com/rjbs/rjbs-dots

indent = 2

end_separator = 1
hash_separator = " => "
print_escapes = 1
show_readonly = 1

# loading Web before JType so JType can replace Typist formatting
filters = DateTime, Web, JType, JMAP

filter_datetime.show_class_name = 1
filter_datetime.show_timezone   = 1

